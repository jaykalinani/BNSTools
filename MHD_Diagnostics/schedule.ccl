# Schedule definitions for thorn MHD_Diagnostics
# $Header:$

STORAGE: smallb_Poyn, velocity_derivatives_3p1, constraints_derivative_tensors, diagnostics_mhd, vels_old

STORAGE: ADMBaseX::metric, ADMBaseX::curv, ADMBaseX::lapse, ADMBaseX::shift

STORAGE: HydroBaseX::rho,HydroBaseX::vel,HydroBaseX::Bvec

#SCHEDULE compute_bi_b2_Poyn_fluxET AT CCTK_POSTINITIAL AFTER SetTmunu
#{
#  LANG: C
#} "Set b^mu, b^2, and Poynting flux gridfunctions."

# SCHEDULE init_fields IN Margherita_ID after fix_ID 
# {
#   LANG: C
# } "Set all diagnostic fields to zero in the beginning."

SCHEDULE init_fields IN HydroBaseX_InitialData #after ID_TabEOS_HydroQuantities
{
  LANG: C
  WRITES: smallb_Poyn(everywhere) velocity_derivatives_3p1(everywhere) constraints_derivative_tensors(everywhere) diagnostics_mhd(everywhere)
} "Set all diagnostic fields to zero in the beginning."

SCHEDULE MHD_Diagnostics_Reset_VelsOld_PostRegrid AT postinitial AFTER ODESolvers_PostStep
{
  LANG: C
  READS: HydroBaseX::vel(everywhere) AsterX::w_lorentz(everywhere)
  WRITES: vels_old(everywhere)
  SYNC: vels_old
} "Initialize MHD diagnostics old velocity storage"

SCHEDULE init_fields AT post_recover_variables AFTER ODESolvers_PostStep
{
  LANG: C
  WRITES: smallb_Poyn(everywhere) velocity_derivatives_3p1(everywhere) constraints_derivative_tensors(everywhere) diagnostics_mhd(everywhere)
} "Initialize non-checkpointed MHD diagnostic fields after recovery"

SCHEDULE MHD_Diagnostics_Sync_Recovered AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: vels_old
} "Synchronize recovered MHD diagnostics restart storage"

SCHEDULE init_fields AT postregrid AFTER ODESolvers_PostStep
{
  LANG: C
  WRITES: smallb_Poyn(everywhere) velocity_derivatives_3p1(everywhere) constraints_derivative_tensors(everywhere) diagnostics_mhd(everywhere)
} "Initialize MHD diagnostic fields after regrid"

SCHEDULE MHD_Diagnostics_Reset_VelsOld_PostRegrid AT postregrid AFTER (ODESolvers_PostStep init_fields)
{
  LANG: C
  READS: HydroBaseX::vel(everywhere) AsterX::w_lorentz(everywhere)
  WRITES: vels_old(everywhere)
  SYNC: vels_old
} "Reset MHD diagnostics old velocity storage after regrid"

SCHEDULE compute_mhd_diagnostics AT CCTK_ANALYSIS BEFORE compute_mhd_derivs
{
  LANG: C
  READS: ADMBaseX::metric(everywhere) ADMBaseX::lapse(everywhere) ADMBaseX::shift(everywhere)
  READS: HydroBaseX::vel(everywhere) HydroBaseX::Bvec(everywhere)
  READS: AsterX::w_lorentz(everywhere)
  READS: smallb_Poyn(everywhere)
  WRITES: smallb_Poyn(everywhere)
} "Set b^mu, b^2, and Poynting flux gridfunctions"

SCHEDULE compute_mhd_derivs AT CCTK_ANALYSIS AFTER compute_mhd_diagnostics
{
  LANG: C
  READS: ADMBaseX::lapse(everywhere) ADMBaseX::shift(everywhere) ADMBaseX::metric(everywhere) ADMBaseX::curv(everywhere)
  READS: HydroBaseX::vel(everywhere) HydroBaseX::rho(everywhere) HydroBaseX::Bvec(everywhere)
  READS: AsterX::dBx_stag(everywhere) AsterX::dBy_stag(everywhere) AsterX::dBz_stag(everywhere)
  READS: AsterX::w_lorentz(everywhere)
  READS: smallb_Poyn(everywhere), vels_old(interior)
  READS: velocity_derivatives_3p1(interior) constraints_derivative_tensors(interior) diagnostics_mhd(interior)
  WRITES: velocity_derivatives_3p1(interior) constraints_derivative_tensors(interior) diagnostics_mhd(interior) vels_old(interior)
  SYNC: velocity_derivatives_3p1 constraints_derivative_tensors diagnostics_mhd vels_old
} "Set fluid derivatives"


