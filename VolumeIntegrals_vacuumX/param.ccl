# Parameter definitions for thorn VolumeIntegrals_vacuumX
# $Header:$

KEYWORD domain "Domain type"
{
  "octant"   :: "Use an octant about the origin"
  "bitant"   :: "Use a bitant about the x-y plane"
  "full"     :: "Use the full domain"
} "full"


private:

###################################################
# The following variables set the constraint       #
# gridfunctions used by this thorn.                #
# Defaults target CarpetX spacetime thorns.        #
###################################################
CCTK_STRING HamiltonianVarString "Hamiltonian constraint variable name" STEERABLE = RECOVER
{
  "Z4c::HC"                 :: "Z4c thorn Hamiltonian constraint gridfunction name"
  "CanudaX_BSSNMoL::hc"     :: "CanudaX_BSSNMoL thorn Hamiltonian constraint gridfunction name"
  ".+"                      :: "Use your own thorn's Hamiltonian constraint gridfunction name"
} "Z4c::HC"

CCTK_STRING Momentum0VarString "Momentum constraint variable name (x-direction)" STEERABLE = RECOVER
{
  "Z4c::MtCx"               :: "Z4c thorn momentum-constraint x gridfunction name"
  "CanudaX_BSSNMoL::mcx"    :: "CanudaX_BSSNMoL thorn momentum-constraint x gridfunction name"
  ".+"                      :: "Use your own thorn's momentum constraint gridfunction name"
} "Z4c::MtCx"

CCTK_STRING Momentum1VarString "Momentum constraint variable name (y-direction)" STEERABLE = RECOVER
{
  "Z4c::MtCy"               :: "Z4c thorn momentum-constraint y gridfunction name"
  "CanudaX_BSSNMoL::mcy"    :: "CanudaX_BSSNMoL thorn momentum-constraint y gridfunction name"
  ".+"                      :: "Use your own thorn's momentum constraint gridfunction name"
} "Z4c::MtCy"

CCTK_STRING Momentum2VarString "Momentum constraint variable name (z-direction)" STEERABLE = RECOVER
{
  "Z4c::MtCz"               :: "Z4c thorn momentum-constraint z gridfunction name"
  "CanudaX_BSSNMoL::mcz"    :: "CanudaX_BSSNMoL thorn momentum-constraint z gridfunction name"
  ".+"                      :: "Use your own thorn's momentum constraint gridfunction name"
} "Z4c::MtCz"

CCTK_STRING MomentumSquaredVarString "Momentum constraint squared variable name" STEERABLE = RECOVER
{
  "UNSET"                   :: "No default M^2 variable in Z4c/CanudaX_BSSNMoL; set explicitly if using H_M2_CnstraintsL2"
  ".+"                      :: "Use your own thorn's momentum-constraint-squared gridfunction name"
} "UNSET"

###################################################

CCTK_INT enable_file_output "Enable output file" STEERABLE = RECOVER
{
  0:1 :: "0 = no output; 1 = yes, output to file"
} 1

STRING outVolIntegral_dir "Output directory for volume integration output files, overrides IO::out_dir" STEERABLE = RECOVER
{
  ".+" :: "A valid directory name"
  "^$" :: "An empty string to choose the default from IO::out_dir"
} ""

CCTK_INT VolIntegral_out_every "How often to compute volume integrals?" STEERABLE = ALWAYS
{
  0:1000 :: "zero (disable integration) or some other number"
} 0

CCTK_INT NumIntegrals "Number of volume integrals to perform" STEERABLE = ALWAYS
{
  0:100 :: "zero (disable integration) or some other number"
} 0

keyword Integration_quantity_keyword[101] "Which quantity to integrate" STEERABLE = ALWAYS
{
"nothing"                 :: "Default, null parameter"
"H_M_CnstraintsL2"        :: "Hamiltonian, Momentum^i"
"H_M2_CnstraintsL2"       :: "Hamiltonian, Momentum squared"
"usepreviousintegrands"   :: "Use integrands from step(s) immediately preceeding. Useful for Swiss-cheese-type volume integrations."
"centeroflapse"           :: "Center of Lapse"
"one"                     :: "Integrand = 1. Useful for debugging"
"ADM_Mass"                :: "ADM Mass"
"ADM_Mass_Surface"        :: "ADM mass from a direct coordinate-sphere integral using conformal fluxes"
"ADM_Momentum"            :: "ADM Momentum"
"ADM_Momentum_Surface"    :: "ADM linear momentum components from a direct coordinate-sphere integral using conformal fluxes"
"ADM_Angular_Momentum"    :: "ADM Angular Momentum"
"ADM_Angular_Momentum_Surface" :: "ADM angular momentum components from a direct coordinate-sphere integral using conformal fluxes"
} "nothing"

########################################

CCTK_INT volintegral_usepreviousintegrands_num_integrands[101] "Number of integrands for usepreviousintegrands, must be specified explicitly as information from previous integrand is not passed." STEERABLE = ALWAYS
{
  0:100 :: "Default is set to the maximum, 4."
} 4


########################################
CCTK_REAL volintegral_sphere__center_x_initial[101] "Volume integral in a spherical region: x-coord of center(s)" STEERABLE=ALWAYS
{
  *:* :: "Any number"
} 0

CCTK_REAL volintegral_sphere__center_y_initial[101] "Volume integral in a spherical region: y-coord of center(s)" STEERABLE=ALWAYS
{
  *:* :: "Any number"
} 0

CCTK_REAL volintegral_sphere__center_z_initial[101] "Volume integral in a spherical region: z-coord of center(s)" STEERABLE=ALWAYS
{
  *:* :: "Any number"
} 0

########################################

CCTK_REAL volintegral_inside_sphere__radius[101] "Volume integral in a spherical region: radius of spherical region" STEERABLE=ALWAYS
{
  *:* :: "Any number"
} 0
CCTK_REAL volintegral_outside_sphere__radius[101] "Volume integral outside a spherical region: radius of spherical region" STEERABLE=ALWAYS
{
  *:* :: "Any number"
} 0

CCTK_REAL volintegral_surface_sphere__radius[101] "Direct coordinate-sphere integral: radius of spherical surface" STEERABLE=ALWAYS
{
  *:* :: "Any number"
} 0

CCTK_REAL volintegral_surface_sphere__width[101] "Deprecated compatibility parameter; direct spherical extraction ignores it" STEERABLE=ALWAYS
{
  *:* :: "Any number"
} 0

CCTK_STRING surface_interpolator_name "Interpolator used for direct spherical ADM extraction"
{
  ".+" :: "A registered Cactus interpolator"
} "CarpetX"

CCTK_STRING surface_interpolator_pars "Parameters for direct spherical ADM interpolation"
{
  ".*" :: "Any string accepted by Util_TableSetFromString"
} "order=4 boundary_off_centering_tolerance={0 0 0 0 0 0} boundary_extrapolation_tolerance={0 0 0 0 0 0}"

CCTK_INT surface_ntheta "Number of theta points for direct spherical extraction, including both poles"
{
  3:*:2 :: "An odd number for composite Simpson quadrature"
} 37

CCTK_INT surface_nphi "Number of periodic phi points for direct spherical extraction; the 2*pi endpoint is omitted"
{
  2:* :: "At least two periodic points"
} 24

########################################
# Constraint-norm excision

CCTK_INT constraint_excision_num_regions "Number of spherical regions excised from constraint norms"
{
  0:100 :: "Zero disables inner constraint excision"
} 0

CCTK_REAL constraint_excision_center_x[100] "Fixed x-coordinate of a constraint-excision region"
{
  *:* :: "Any coordinate"
} 0

CCTK_REAL constraint_excision_center_y[100] "Fixed y-coordinate of a constraint-excision region"
{
  *:* :: "Any coordinate"
} 0

CCTK_REAL constraint_excision_center_z[100] "Fixed z-coordinate of a constraint-excision region"
{
  *:* :: "Any coordinate"
} 0

CCTK_REAL constraint_excision_radius[100] "Radius of a constraint-excision region"
{
  0:* :: "Zero disables this region"
} 0

CCTK_INT constraint_excision_tracks_amr_centre[100] "BoxInBox center tracked by this constraint-excision region"
{
  -1:99 :: "-1 uses the fixed center; 0..99 selects a BoxInBox center"
} -1

CCTK_REAL constraint_excision_outer_radius "Zero constraint integrands outside this coordinate radius"
{
  *:* :: "A positive radius enables outer excision"
} 0

CCTK_REAL constraint_excision_outer_center_x "x-coordinate of the outer constraint-excision sphere"
{
  *:* :: "Any coordinate"
} 0

CCTK_REAL constraint_excision_outer_center_y "y-coordinate of the outer constraint-excision sphere"
{
  *:* :: "Any coordinate"
} 0

CCTK_REAL constraint_excision_outer_center_z "z-coordinate of the outer constraint-excision sphere"
{
  *:* :: "Any coordinate"
} 0

########################################

CCTK_INT amr_centre__tracks__volintegral_inside_sphere[101] "Use output from volume integral to move AMR box centre N." STEERABLE = ALWAYS
{
  -1:99 :: "-1 = do not track an AMR box centre; 0..99 selects a BoxInBox centre."
} -1


CCTK_INT volintegral_sphere__tracks__amr_centre[101] "Volume integral tracks AMR box centre N." STEERABLE = ALWAYS
{
  -1:99 :: "-1 = do not track an AMR box centre; 0..99 selects a BoxInBox centre."
} -1


########################################

CCTK_INT verbose "Set verbosity level: 1=useful info; 2=moderately annoying (though useful for debugging)" STEERABLE=ALWAYS
{
  0:2 :: "0 = no output; 1=useful info; 2=moderately annoying (though useful for debugging)"
} 1

#############################################################################

BOOLEAN enable_time_reparameterization "Enable time reparameterization a la http://arxiv.org/abs/1404.6523" STEERABLE = ALWAYS
{
} "no"

CCTK_REAL VIv_time_reparam_t0 "Time reparameterization parameter t_0: Center of time reparameterization curve. SET TO BE SAME AS IN ImprovedPunctureGauge thorn"
{
 0:* :: "Probably don't want to set this <0, so >=0 enforced"
} 10.0

CCTK_REAL VIv_time_reparam_w "Time reparameterization parameter w: Width of time reparameterization curve. SET TO BE SAME AS IN ImprovedPunctureGauge thorn"
{
 0:* :: "Probably don't want to set this <0, so >=0 enforced"
} 5.0


#############################################################################
### import IOUtil parameters
#############################################################################
shares: IO

USES STRING out_dir
